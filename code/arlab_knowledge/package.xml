<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arlab_knowledge</name>
  <version>0.1.0</version>
  <description>Arlab knowledge base: database for handling the robot's surroundings, events and maps</description>
  <maintainer email="peter.viechter@uni-a.de">Peter Viechter</maintainer>
  <maintainer email="daniel.gabler@uni-a.de">Daniel Gabler</maintainer>
  <license>MIT</license>

  <test_depend>python3-pytest</test_depend>

  <depend>nav_msgs</depend>

  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
