    <!-- Optional fixed joint used for the stationary manipulator setup.
         For the mobile Gazebo setup this is disabled, so ranger_base_link
         becomes the root of the spawned robot model and can move in Gazebo. -->
    <xacro:if value="${attach_to_parent}">
      <joint name="${name}_joint" type="fixed">
        <parent link="${parent_link}"/>
        <child  link="ranger_base_link"/>
        <origin xyz="${xyz}" rpy="${rpy}"/>
      </joint>
    </xacro:if>



  </xacro:macro>

</robot>
