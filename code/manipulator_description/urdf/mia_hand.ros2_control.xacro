<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro
    name="mia_hand_ros2_control"
    params="name prefix serial_port use_mock_hardware">

    <ros2_control name="${name}" type="system">

      <!-- Real hardware: echte Mia-Hand über Serial Interface -->
      <xacro:unless value="${use_mock_hardware}">
        <hardware>
          <plugin>mia_hand_ros2_control/MiaHandSystemInterface</plugin>
          <param name="serial_port">${serial_port}</param>
        </hardware>
      </xacro:unless>

      <!-- Simulation: Mia-Hand-Joints werden von Gazebo / gz_ros2_control bereitgestellt -->
      <xacro:if value="${use_mock_hardware}">
        <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
      </xacro:if>

      <!-- Thumb opposition joint: nur falls du ihn später auch steuern willst -->
      <joint name="${prefix}j_thumb_opp">
        <command_interface name="position">
          <param name="min">-1.0</param>
          <param name="max">1.0</param>
        </command_interface>
        <command_interface name="velocity">
          <param name="min">-2.0</param>
          <param name="max">2.0</param>
        </command_interface>

        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>

      <!-- Thumb flexion -->
      <joint name="${prefix}j_thumb_fle">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">1.2</param>
        </command_interface>
        <command_interface name="velocity">
          <param name="min">-2.0</param>
          <param name="max">2.0</param>
        </command_interface>

        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>

      <!-- Index flexion -->
      <joint name="${prefix}j_index_fle">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">1.2</param>
        </command_interface>
        <command_interface name="velocity">
          <param name="min">-2.0</param>
          <param name="max">2.0</param>
        </command_interface>

        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>

      <!-- Middle / Ring / Little flexion combined -->
      <joint name="${prefix}j_mrl_fle">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">1.2</param>
        </command_interface>
        <command_interface name="velocity">
          <param name="min">-2.0</param>
          <param name="max">2.0</param>
        </command_interface>

        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>

    </ros2_control>

  </xacro:macro>

</robot>