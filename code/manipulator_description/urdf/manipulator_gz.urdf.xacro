<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur5e">

  <!-- import ur5 macro -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <!-- import ur5 ROS2 control macro -->
  <xacro:include filename="$(find ur_simulation_gz)/urdf/ur_gz.ros2_control.xacro" />

  <!-- import Mia Hand macro -->
  <xacro:include filename="$(find mia_hand_description)/urdf/mia_hand.urdf.xacro"/>
  <!-- import Mia Hand ROS2 control macro -->
  <xacro:include filename="$(find manipulator_description)/urdf/mia_hand.ros2_control.xacro"/>

  <!-- import Camera macro -->
  <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro"/>

  <!-- import Realsense Mount macro -->
  <xacro:include filename="$(find manipulator_description)/urdf/ur_realsense_mount.xacro"/>

  <!-- import Scene Objects macro -->
  <xacro:include filename="$(find manipulator_description)/urdf/schrankregal.xacro"/>

  <!-- import UR Sockel macro -->
  <xacro:include filename="$(find manipulator_description)/urdf/ur_sockel.xacro"/>

  <!-- possible 'ur_type' values: ur3, ur3e, ur5, ur5e, ur7e, ur10, ur10e, ur12e, ur16e, ur15, ur20, ur30 -->
  <!-- the default value should raise an error in case this was called without defining the type -->
  <xacro:arg name="ur_type" default="ur5e"/>
  <xacro:arg name="tf_prefix" default="" />

  <xacro:arg name="joint_limit_params" default="$(find manipulator_description)/config/ur_joint_limits.yaml"/>

  <xacro:arg name="kinematics_params" default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_params" default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params" default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>

  <xacro:arg name="transmission_hw_interface" default=""/>

  <xacro:arg name="safety_limits" default="false"/>
  <xacro:arg name="safety_pos_margin" default="0.15"/>
  <xacro:arg name="safety_k_position" default="20"/>

  <xacro:arg name="simulation_controllers" default="" />
  <xacro:arg name="ros_namespace" default="" />

  <!-- mia hand parameters -->
  <xacro:arg name="serial_port" default="/dev/ttyUSB0"/>
  <xacro:arg name="laterality" default="right" />
  <xacro:arg name="joint_limits_config_file" default="joint_limits_default.yaml"/>
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="use_mock_hardware" default="true"/>

  <!-- create link fixed to the "world" -->
  <link name="world" />

  <link name="ground_plane">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="5 5 0"/>
      </geometry>
      <material name="ground_white">
        <color rgba="1 1 1 0.5"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="5 5 0"/>
      </geometry>
    </collision>
  </link>

  <joint name="ground_plane_joint" type="fixed">
    <origin xyz="0 0 -0.01" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="ground_plane"/>
  </joint>

  <!-- UR Sockel -->
  <xacro:ur_sockel
    name="ur_sockel"
    parent_link="world"
    xyz="0 0 0"
    rpy="0 0 0">
  </xacro:ur_sockel>

  <!-- scene -->
  <xacro:schrankregal
    name="unten"
    parent_link="world"
    xyz="-0.42 0.42 0"
    rpy="1.571 0 -0.960">
  </xacro:schrankregal>

  <!-- scene -->
  <xacro:schrankregal
    name="mitte"
    parent_link="world"
    xyz="-0.42 0.42 0.46"
    rpy="1.571 0 -0.960">
  </xacro:schrankregal>

  <!-- scene -->
  <xacro:schrankregal
    name="oben"
    parent_link="world"
    xyz="-0.42 0.42 0.92"
    rpy="1.571 0 -0.960">
  </xacro:schrankregal>

  <!-- arm -->
  <xacro:ur_robot
    parent="world"
    name="$(arg ur_type)"
    tf_prefix="$(arg tf_prefix)"
    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)"
    safety_limits="$(arg safety_limits)"
    safety_pos_margin="$(arg safety_pos_margin)"
    safety_k_position="$(arg safety_k_position)"
    force_abs_paths="true">
    <origin xyz="0 0 0.07" rpy="0 0 0" />
  </xacro:ur_robot>

  <xacro:ur_realsense_mount
    parent_link="tool0"
    xyz="0 0 0"
    rpy="0 0 0">
  </xacro:ur_realsense_mount>

  <!-- mia hand -->
  <xacro:mia_hand
    laterality="$(arg laterality)"
    joint_limits_config_file="$(arg joint_limits_config_file)"
    parent="ur_realsense_mount_link"
    prefix="$(arg prefix)">
    <xacro:if value="${'right' == '$(arg laterality)'}">
      <origin xyz="0 0 0" rpy="1.59 0 1.59"/>
    </xacro:if>
    <xacro:if value="${'left' == '$(arg laterality)'}">
      <origin xyz="0 0 0" rpy="1.57 3.14 0.1"/>
    </xacro:if>
  </xacro:mia_hand>

   <!-- RealSense D435 Camera -->
  <xacro:sensor_d435
      name="camera"
      parent="base_link"
      use_nominal_extrinsics="false"
      add_plug="false"
      use_mesh="true">
    <origin xyz="0.35 -0.35 0.57" rpy="0 0 2.35619"/>
  </xacro:sensor_d435>

  <!-- RealSense D435 Camera Tool-->
  <!-- <xacro:sensor_d435
      name="camera"
      parent="tool0"
      use_nominal_extrinsics="false"
      add_plug="false"
      use_mesh="true">
    <origin xyz="0 0.135 0.012" rpy="0 -1.57 1.57"/>
  </xacro:sensor_d435> -->

  <!-- Gazebo specific elements -->
  <gazebo reference="world"></gazebo>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg simulation_controllers)</parameters>
      <ros>
        <namespace>$(arg ros_namespace)</namespace>
      </ros>
    </plugin>
  </gazebo>

  <!-- <gazebo reference="camera_depth_frame">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>5</update_rate>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>3.0</far>
        </clip>
      </camera>
      <topic>/rgbd_camera</topic>
    </sensor>
  </gazebo> -->

  <!-- ros2 control instance -->
  <xacro:ur_ros2_control
    name="$(arg ur_type)"
    tf_prefix="$(arg tf_prefix)"
    transmission_hw_interface="$(arg transmission_hw_interface)"
  />

  <!-- mia hand ros2 control instance -->
  <xacro:mia_hand_ros2_control
    name="MiaHand"
    prefix="$(arg prefix)"
    serial_port="$(arg serial_port)"
    use_mock_hardware="$(arg use_mock_hardware)"
  />


</robot>
