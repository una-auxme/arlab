<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg ur_type)">

  <!-- Mobile simulation variant:
       - ranger_base_link is the root link of the Gazebo model
       - the base is not fixed to world
       - Gazebo receives /cmd_vel and moves the whole model omnidirectionally
       - OdometryPublisher publishes odom -> ranger_base_link
  -->

  <xacro:arg name="use_mock_hardware" default="true" />
  <xacro:property name="use_mock_hardware" value="$(arg use_mock_hardware)"/>

  <!-- UR arm description and ros2_control -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:if value="${use_mock_hardware}">
    <xacro:include filename="$(find ur_simulation_gz)/urdf/ur_gz.ros2_control.xacro" />
  </xacro:if>
  <xacro:unless value="${use_mock_hardware}">
    <xacro:include filename="$(find ur_robot_driver)/urdf/ur.ros2_control.xacro"/>
    <xacro:include filename="$(find ur_description)/urdf/inc/ur_transmissions.xacro" />
  </xacro:unless>

  <!-- Additional manipulator parts -->
  <xacro:include filename="$(find manipulator_description)/urdf/mia_hand.urdf.xacro"/>
  <xacro:include filename="$(find manipulator_description)/urdf/mia_hand.ros2_control.xacro"/>
  <xacro:include filename="$(find manipulator_description)/urdf/_d435.urdf.xacro"/>
  <xacro:include filename="$(find manipulator_description)/urdf/ur_realsense_mount.xacro"/>
  <xacro:include filename="$(find manipulator_description)/urdf/ur_chasis.xacro"/>
  <xacro:include filename="$(find manipulator_description)/urdf/ranger_air_description.xacro"/>

  <!-- UR parameters -->
  <xacro:arg name="ur_type" default="ur5e"/>
  <xacro:arg name="tf_prefix" default="" />
  <xacro:arg name="joint_limit_params" default="$(find manipulator_description)/config/ur_joint_limits.yaml"/>
  <xacro:arg name="kinematics_params" default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_params" default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params" default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>
  <xacro:arg name="transmission_hw_interface" default=""/>
  <xacro:arg name="safety_limits" default="false"/>
  <xacro:arg name="safety_pos_margin" default="0.15"/>
  <xacro:arg name="safety_k_position" default="20"/>

  <xacro:unless value="${use_mock_hardware}">
    <xacro:arg name="headless_mode" default="false" />
    <xacro:arg name="robot_ip" default="0.0.0.0"/>
    <xacro:arg name="script_filename" default=""/>
    <xacro:arg name="output_recipe_filename" default=""/>
    <xacro:arg name="input_recipe_filename" default=""/>
    <xacro:arg name="reverse_ip" default="0.0.0.0"/>
    <xacro:arg name="script_command_port" default="50004"/>
    <xacro:arg name="reverse_port" default="50001"/>
    <xacro:arg name="script_sender_port" default="50002"/>
    <xacro:arg name="trajectory_port" default="50003"/>
    <xacro:arg name="use_tool_communication" default="false" />
    <xacro:arg name="tool_voltage" default="0" />
    <xacro:arg name="tool_parity" default="0" />
    <xacro:arg name="tool_baud_rate" default="115200" />
    <xacro:arg name="tool_stop_bits" default="1" />
    <xacro:arg name="tool_rx_idle_chars" default="1.5" />
    <xacro:arg name="tool_tx_idle_chars" default="3.5" />
    <xacro:arg name="tool_device_name" default="/tmp/ttyUR" />
    <xacro:arg name="tool_tcp_port" default="54321" />
  </xacro:unless>

  <!-- Simulation parameters -->
  <xacro:arg name="mock_sensor_commands" default="false" />
  <xacro:arg name="simulation_controllers" default="" />
  <xacro:arg name="ros_namespace" default="" />
  <xacro:arg name="lock_base_tilt" default="true" />
  <xacro:arg name="initial_positions_file" default="$(find ur_description)/config/initial_positions.yaml"/>
  <xacro:property name="initial_positions_file" default="$(arg initial_positions_file)"/>

  <!-- MANUELLE ARM-STARTPOSITION IN RADIAN -->
  <xacro:property name="manual_arm_initial_positions" value="${dict(shoulder_pan_joint=0.0, shoulder_lift_joint=-1.57, elbow_joint=1.57, wrist_1_joint=-1.57, wrist_2_joint=-1.57, wrist_3_joint=0.0)}"/>

  <!-- Mia hand parameters -->
  <xacro:arg name="serial_port" default="/dev/ttyUSB0"/>
  <xacro:arg name="laterality" default="right" />
  <xacro:arg name="joint_limits_config_file" default="joint_limits_default.yaml"/>
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="mia_use_mock_hardware" default="true"/>

  <!-- Mobile base. No fixed joint to world here. Wheel and steering joints are
       fixed in this kinematic mobile simulation so the model does not fall apart
       while the Gazebo velocity controller moves the whole model. -->
  <xacro:ranger_air_description
    name="ranger_air_description"
    parent_link="unused"
    xyz="0 0 0"
    rpy="0 0 0"
    use_mock_hardware="true"
    attach_to_parent="false"
    fix_wheel_joints="true">
  </xacro:ranger_air_description>

  <xacro:if value="$(arg lock_base_tilt)">
    <!-- Anti-tip stabilisation for the mobile Gazebo setup.
         The mobile base is moved by gz-sim-velocity-control-system via /cmd_vel,
         so we do not need Gazebo to solve roll/pitch dynamics for the root link.
         Marking ranger_base_link as kinematic prevents the complete robot from
         tipping over, while x/y/yaw motion through /cmd_vel still works.
         The hidden ballast link is an additional fallback for Gazebo versions that
         ignore <kinematic> from URDF conversion: it lowers the combined centre of
         mass and makes roll/pitch numerically very hard to excite. -->
    <gazebo reference="ranger_base_link">
      <gravity>false</gravity>
      <kinematic>true</kinematic>
      <self_collide>false</self_collide>
    </gazebo>

    <link name="anti_tip_ballast_link">
      <inertial>
        <origin xyz="0 0 -0.20" rpy="0 0 0"/>
        <mass value="250.0"/>
        <inertia
          ixx="5000.0" ixy="0.0" ixz="0.0"
          iyy="5000.0" iyz="0.0"
          izz="5000.0"/>
      </inertial>
    </link>

    <joint name="anti_tip_ballast_joint" type="fixed">
      <parent link="ranger_base_link"/>
      <child link="anti_tip_ballast_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <gazebo reference="anti_tip_ballast_link">
      <visualize>false</visualize>
      <self_collide>false</self_collide>
    </gazebo>
  </xacro:if>

  <!-- UR chassis mounted on the Ranger Air base -->
  <xacro:ur_chasis
    name="ur_chasis"
    parent_link="ranger_base_link"
    xyz="0 0 0"
    rpy="0 0 0">
  </xacro:ur_chasis>

  <!-- UR arm -->
  <xacro:ur_robot
    parent="ur_chasis_link"
    name="$(arg ur_type)"
    tf_prefix="$(arg tf_prefix)"
    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)"
    safety_limits="$(arg safety_limits)"
    safety_pos_margin="$(arg safety_pos_margin)"
    safety_k_position="$(arg safety_k_position)"
    force_abs_paths="true">
    <origin xyz="0 0 1.142" rpy="0 0 0" />
  </xacro:ur_robot>

  <xacro:ur_realsense_mount
    parent_link="tool0"
    xyz="0 0 0"
    rpy="0 0 0">
  </xacro:ur_realsense_mount>

  <!-- Mia hand -->
  <xacro:mia_hand
    laterality="$(arg laterality)"
    joint_limits_config_file="$(arg joint_limits_config_file)"
    parent="ur_realsense_mount_link"
    prefix="$(arg prefix)">
    <xacro:if value="${'right' == '$(arg laterality)'}">
      <origin xyz="0 0 0" rpy="1.59 0 1.59"/>
    </xacro:if>
    <xacro:if value="${'left' == '$(arg laterality)'}">
      <origin xyz="0 0 0" rpy="1.57 3.14 0.1"/>
    </xacro:if>
  </xacro:mia_hand>

  <!-- RealSense D435 camera on the gripper -->
  <xacro:sensor_d435
      name="camera_gripper"
      parent="tool0"
      use_nominal_extrinsics="false"
      add_plug="false"
      use_mesh="true">
    <origin xyz="-0.001 0.102 0.052" rpy="0 1.31 1.57"/>
  </xacro:sensor_d435>

  <xacro:if value="${use_mock_hardware}">
    <!-- Gazebo ros2_control for the UR arm and Mia hand controllers -->
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg simulation_controllers)</parameters>
        <ros>
          <namespace>$(arg ros_namespace)</namespace>
        </ros>
      </plugin>
    </gazebo>

    <!-- Kinematic omni base control for quick simulation and Nav2 tests.
         This is deliberately separated from the arm ros2_control setup:
         /cmd_vel controls the Ranger Air base, while MoveIt still controls the UR arm. -->
    <gazebo>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/cmd_vel</topic>
      </plugin>

      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>ranger_base_link</robot_base_frame>
        <odom_publish_frequency>50</odom_publish_frequency>
        <odom_topic>/odom</odom_topic>
        <odom_covariance_topic>/odom_with_covariance</odom_covariance_topic>
        <tf_topic>/tf</tf_topic>
        <dimensions>2</dimensions>
      </plugin>
    </gazebo>

    <!-- Simple 2D lidar for SLAM/Nav2. It is mounted to the existing front_lidar_link. -->
    <gazebo reference="front_lidar_link">
      <sensor name="front_lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <topic>/scan</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3</min_angle>
              <max_angle>3</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.10</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:if>

  <!-- ros2_control instance for the UR arm -->
  <xacro:if value="${use_mock_hardware}">
    <xacro:ur_ros2_control
      name="$(arg ur_type)"
      tf_prefix="$(arg tf_prefix)"
      transmission_hw_interface="$(arg transmission_hw_interface)"
      initial_positions="${manual_arm_initial_positions}"
    />
  </xacro:if>
  <xacro:unless value="${use_mock_hardware}">
    <xacro:ur_ros2_control
      name="$(arg ur_type)"
      tf_prefix="$(arg tf_prefix)"
      kinematics_parameters_file="$(arg kinematics_params)"
      transmission_hw_interface="$(arg transmission_hw_interface)"
      use_mock_hardware="$(arg use_mock_hardware)"
      mock_sensor_commands="$(arg mock_sensor_commands)"
      headless_mode="$(arg headless_mode)"
      initial_positions="${manual_arm_initial_positions}"
      use_tool_communication="$(arg use_tool_communication)"
      tool_voltage="$(arg tool_voltage)"
      tool_parity="$(arg tool_parity)"
      tool_baud_rate="$(arg tool_baud_rate)"
      tool_stop_bits="$(arg tool_stop_bits)"
      tool_rx_idle_chars="$(arg tool_rx_idle_chars)"
      tool_tx_idle_chars="$(arg tool_tx_idle_chars)"
      tool_device_name="$(arg tool_device_name)"
      tool_tcp_port="$(arg tool_tcp_port)"
      robot_ip="$(arg robot_ip)"
      script_filename="$(arg script_filename)"
      output_recipe_filename="$(arg output_recipe_filename)"
      input_recipe_filename="$(arg input_recipe_filename)"
      reverse_ip="$(arg reverse_ip)"
      script_command_port="$(arg script_command_port)"
      reverse_port="$(arg reverse_port)"
      script_sender_port="$(arg script_sender_port)"
      trajectory_port="$(arg trajectory_port)"
    />
  </xacro:unless>

  <!-- Mia hand ros2_control instance -->
  <xacro:mia_hand_ros2_control
    name="MiaHand"
    prefix="$(arg prefix)"
    serial_port="$(arg serial_port)"
    use_mock_hardware="$(arg mia_use_mock_hardware)"
  />

</robot>
