<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="apollo_base" params="name parent_link xyz rpy use_mock_hardware">

    <!-- Neuer Link -->
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0.03" rpy="3.14159 0 0"/>
        <geometry>
          <mesh filename="file://$(find manipulator_description)/meshes/apollo20.obj" scale="0.006 0.006 0.006"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="0 0 0.03" rpy="3.14159 0 0"/>
        <geometry>
          <mesh filename="file://$(find manipulator_description)/meshes/apollo20.obj" scale="0.006 0.006 0.006"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0.5" rpy="0 0 0"/>
        <mass value="1"/>
        <inertia ixx="100"  ixy="0"  ixz="0" iyy="100" iyz="0" izz="100" />
      </inertial>

    </link>

    <!-- Fixed Joint -->
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child  link="${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

  </xacro:macro>

</robot>
