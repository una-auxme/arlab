<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="ur_chasis" params="name parent_link xyz rpy">

    <!-- Neuer Link -->
    <link name="${name}_link">
      <visual>
        <origin xyz="-0.2648 -0.2659 0.2685" rpy="1.57079 0 -3.14159"/>
        <geometry>
          <mesh filename="file://$(find manipulator_description)/meshes/chasis.obj" scale="0.017 0.017 0.017"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="-0.2648 -0.2659 0.291" rpy="1.57079 0 -3.14159"/>
        <geometry>
          <mesh filename="file://$(find manipulator_description)/meshes/chasis.obj" scale="0.017 0.017 0.017"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0.5" rpy="0 0 0"/>
        <mass value="20"/>
        <inertia ixx="100"  ixy="0"  ixz="0" iyy="100" iyz="0" izz="100" />
      </inertial>

    </link>

    <!-- Fixed Joint -->
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child  link="${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

  </xacro:macro>

</robot>
